# Browser-safe Supabase settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase settings
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Billing - prefer a restricted key (rk_) with least privilege
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Mercado Pago marketplace/OAuth
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_WEBHOOK_SECRET=

# WhatsApp híbrido: Meta global, tokens dos tenants ficam no Vault
WHATSAPP_META_APP_ID=
WHATSAPP_META_APP_SECRET=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_META_REDIRECT_URI=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=

# Evolution API QR Web - server/Vault only
EVOLUTION_API_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Public canonical origin used by legal pages and metadata. Change to https://losbarberos.com.br after DNS cutover.
NEXT_PUBLIC_SITE_URL=https://losbarberos-app.vercel.app
